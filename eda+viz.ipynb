   "source": [
    "baseline = (\n",
    "    referrals['department_referral'].value_counts(\n",
    "        normalize=True).\n",
    "    mul(100).\n",
    "    reindex(race_department_pct.columns)\n",
    ")\n",
    "\n",
    "difference_pp = race_department_pct.sub(\n",
    "    baseline, axis='columns')\n",
    "difference_pp.round(2)"
   ]
