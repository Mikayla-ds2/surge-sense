    "race_weights = referrals['patient_race'].value_counts(normalize=True)\n",
    "\n",
    "department_weighted_difference = (\n",
    "    difference_pp\n",
    "    .abs()\n",
    "    .mul(race_weights, axis=0)\n",
    "    .sum(axis=0)\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "department_weighted_difference.round(1)"
   ]
